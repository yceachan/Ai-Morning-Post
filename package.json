{
  "name": "ai-morning-post",
  "version": "0.1.0",
  "description": "Turn the AI Morning Post RSS feed into a small, private email newsletter.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "amp": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "html-to-text": "^9.0.5",
    "nodemailer": "^7.0.6",
    "sanitize-html": "^2.17.0",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^7.0.1",
    "@types/sanitize-html": "^2.16.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
